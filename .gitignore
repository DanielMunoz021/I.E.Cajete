# Dependencias y builds
node_modules/
dist/
*.tsbuildinfo
# (sitio/ sí se versiona: es el build listo para subir al hosting)

# Configuración con credenciales (nunca al repositorio)
config.php
privado/config.php
.env
.env.*
!.env.example

